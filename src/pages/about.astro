---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { profile } from '~/data/profile';

const metadata = {
  title: 'About Alec Reimel | Software Developer',
  ignoreTitleTemplate: true,
  description:
    'Meet Alec Reimel, a Pennsylvania/New Jersey software developer focused on frontend development, analytics integrations, and practical developer tools. Open to US remote roles.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About"
    title="Alec Reimel"
    subtitle="Software developer, creative technologist, and lifelong cyberpunk."
  />
  <section class="max-w-4xl mx-auto px-6 pb-16 font-kode text-terminal-400 space-y-8">
    <div class="reveal border border-terminal-300 bg-terminal-bg-secondary p-6 space-y-4">
      <h2 class="text-2xl font-uav-mono text-terminal-500">What I build</h2>
      <p>
        I'm a software developer based in Doylestown, Pennsylvania, interested in US remote developer roles. I bring 10+
        years of professional experience in full-stack applications, frontend engineering, and marketing technology,
        including technical leadership, applied AI, and web security.
      </p>
      <p>
        I work with HTML, CSS, JavaScript, React, Next.js, Astro, and Tailwind CSS. I care about interfaces that are
        usable, accessible, and clear, alongside code and documentation that other developers can understand.
      </p>
    </div>
    <div class="reveal border border-terminal-300 bg-terminal-bg-secondary p-6 space-y-4">
      <h2 class="text-2xl font-uav-mono text-terminal-500">Experience and education</h2>
      <p>
        My experience includes Lead Developer at beMarketing, Senior Developer at The Grovery, React Developer at
        Thorium Digital, and Lead Frontend Developer at Oxford Communications. At beMarketing, I led a team supporting
        approximately 300 client websites and built tools for AI knowledge access, fleet monitoring, and workflow
        automation.
      </p>
      <p>{profile.education.degree}, {profile.education.school} ({profile.education.period}).</p>
      <p>
        <a href="/resume" class="underline">View my experience</a>,
        <a href={profile.resumePdf} download class="underline">download my résumé (PDF)</a>, or
        <a href={profile.linkedin} class="underline">connect on LinkedIn</a>.
      </p>
    </div>
    <div class="reveal border border-terminal-300 bg-terminal-bg-secondary p-6 space-y-4">
      <h2 class="text-2xl font-uav-mono text-terminal-500">Projects you can explore</h2>
      <p>
        <a href="/projects/arda-analytics" class="underline">ARDA Analytics</a> brings together browser events, campaign attribution,
        and Google Tag Manager integration. <a href="/projects/ai-hub" class="underline">AI Hub</a> is my public library of
        AI prompts, Claude Code agents and skills, and <a href="/projects/ccstatusboard" class="underline"
          >ccstatusboard</a
        > is a terminal dashboard for Claude Code sessions. Each project page links to its source code.
      </p>
      <p>
        For a concise view of my skills and selected work, see my <a href="/resume" class="underline"
          >professional overview</a
        > or browse <a href="/projects" class="underline">all projects</a>.
      </p>
    </div>
    <div class="reveal border border-terminal-300 bg-terminal-bg-secondary p-6 space-y-4">
      <h2 class="text-2xl font-uav-mono text-terminal-500">Beyond the screen</h2>
      <p>
        Science fiction, digital art, and music shape my approach to technology. I play guitar and bass, experiment with
        synthesizers, and enjoy finding new uses for older hardware. Open source software and useful documentation are
        central to how I like to share my work.
      </p>
      <p>
        Hiring for a developer role? <a href="/contact" class="underline">Get in touch</a> or email
        <a href="mailto:alecreimel@gmail.com" class="underline">alecreimel@gmail.com</a>.
      </p>
    </div>
  </section>
</Layout>
