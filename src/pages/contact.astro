---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactFormFull from '~/components/Forms/ContactFormFull.astro';
import { Icon } from 'astro-icon/components';
import { profile } from '~/data/profile';

const metadata = {
  title: 'Contact Alec Reimel | Software Developer',
  ignoreTitleTemplate: true,
  description:
    'Contact Alec Reimel about remote software developer roles in the US, engineering opportunities, or project collaborations.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's talk about your team" />

  <!-- Contact Form Section -->
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="py-12">
      <!-- Grid Layout: Text | Form -->
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start border border-terminal-400 bg-terminal-bg-secondary shadow p-4 sm:p-6 lg:p-8 lg:divide-x lg:divide-terminal-400"
      >
        <!-- Text Content Column -->
        <div class="space-y-6 md:pr-0 lg:pr-8">
          <div>
            <!--             <h2 class="text-3xl font-bold font-uav-mono text-terminal-500 text-glow-strong mb-4 text-center text-balance"></h2> -->
            <p class="text-terminal-400 font-kode text-lg">
              Hiring a software developer? Send me a message about your team and the role.
              <br /><br />
              I build web interfaces and developer tools with JavaScript, React, Next.js, and Astro. I'm based in the Pennsylvania/New
              Jersey area and interested in remote roles across the US.
              <br /><br />
              You can also contact me directly by email, review my <a href="/resume" class="underline">résumé</a>, or
              <a href={profile.linkedin} class="underline">connect on LinkedIn</a>.
            </p>
          </div>
          <a
            href="mailto:alecreimel@gmail.com"
            class="text-terminal-400 hover:bg-terminal-400 hover:text-terminal-bg-primary transition-colors font-kode text-base sm:text-lg inline-flex max-w-full items-center gap-2 px-2 py-1"
          >
            <Icon name="mdi:email" class="w-6 h-6" />
            alecreimel@gmail.com
          </a>
        </div>

        <!-- Form Column -->
        <div class="md:pl-0 lg:pl-8">
          <div>
            <h2
              class="text-3xl font-bold font-uav-mono text-terminal-500 text-glow-strong mb-4 text-center text-balance"
            >
              Contact Me
            </h2>
          </div>
          <ContactFormFull />
        </div>
      </div>
    </div>
  </div>
</Layout>
