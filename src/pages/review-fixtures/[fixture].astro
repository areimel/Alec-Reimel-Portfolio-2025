---
import Layout from '~/layouts/Layout.astro';
import DecoderText from '~/components/AnimationComponents/DecoderText.astro';

export function getStaticPaths() {
  return process.env.REVIEW_TEST_FIXTURES === '1' ? [{ params: { fixture: 'animations' } }] : [];
}
---

<Layout metadata={{ title: 'Animation regression fixture', robots: { index: false, follow: false } }}>
  <main class="p-8">
    <h1 id="unicode"><DecoderText text="A 🧪 third word" as="span" duration={100} charDelay={10} /></h1>
    <h2 id="auto-top">Auto heading top</h2>
    <h2 id="linked-heading"><a href="#linked-heading">Linked heading</a></h2>
    <div id="reveal-above" class="reveal">Above the hash target</div>
    <div id="loading">
      <DecoderText trigger="loadingScreenEnd" text="Loading complete" duration={100} charDelay={10} />
    </div>
    <div id="hover">
      <DecoderText trigger="hover" text="Hover replay" duration={400} charDelay={10} />
    </div>
    <div id="click">
      <DecoderText trigger="click" text="Click replay" duration={400} charDelay={10} />
    </div>
    <div id="emoji">
      <DecoderText trigger="click" text="Beep 🧪 boop 👩‍🔬" duration={400} charDelay={10} />
    </div>
    <div id="mobile">
      <DecoderText trigger="click" text="Mobile readable" mobileDisable duration={400} charDelay={10} />
    </div>
    <div style="height: 150vh"></div>
    <div id="in-view">
      <DecoderText trigger="in-view" text="Visible later" delay={700} duration={100} charDelay={10} />
    </div>
    <div id="reveal-tall" class="reveal" style="height: 450vh; background: #111"></div>
    <div id="reveal-target" class="reveal">Hash target</div>
    <div style="height: 150vh"></div>
    <h2 id="auto-far">Auto heading far</h2>
    <a href="/">Home</a>
  </main>
</Layout>

<script>
  // Engine fixture: a throwing feature must not stop the next one from running.
  import { onPage } from '~/animation/core';

  onPage(() => {
    throw new Error('fixture: throwing feature');
  });
  onPage(() => {
    document.documentElement.dataset.fixtureOnPage = 'ran';
  });
</script>
