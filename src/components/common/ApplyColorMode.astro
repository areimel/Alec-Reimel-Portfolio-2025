---
import { UI } from 'astrowind:config';
import themeBootstrap from '~/utils/theme-bootstrap.js?raw';
---

<meta name="color-scheme" content="dark light" />
<script is:inline define:vars={{ defaultColorScheme: UI.theme || 'system' }}>
  document.documentElement.dataset.colorScheme = defaultColorScheme;
</script>
<script is:inline set:html={themeBootstrap} />
