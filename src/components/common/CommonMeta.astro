---
import { getAsset } from '~/utils/permalinks';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link rel="sitemap" href={getAsset('/sitemap-index.xml')} />

<!-- Preload both visible terminal fonts so headings and buttons settle before the boot sequence. -->
<link rel="preload" href="/fonts/KodeMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/UAV-OSD-Mono.woff2" as="font" type="font/woff2" crossorigin />
