---
//Astro frontmatter section: props, data, etc.
---

<div class="terminal-overlay" transition:persist="terminal-overlay">
  <div class="noise"></div>

  <div class="scanline"></div>

  <div class="overlay">
    <!-- <div class="corner topRight">&urcorner;</div>
        <div class="corner topLeft">&ulcorner;</div>
        <div class="corner bottomRight">&lrcorner;</div>
        <div class="corner bottomLeft">&llcorner;</div> -->
    <!-- <div class="overlayText">ALEC REIMEL, DEV</div> -->
  </div>
</div>

<style>
  /***** Terminal Effects *****/

  .terminal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    pointer-events: none;
    overflow: hidden;
    contain: strict;
  }

  /* Oversized by one tile on each side so the jitter translate never exposes an edge. */
  .noise {
    pointer-events: none;
    position: absolute;
    inset: -256px;
    background-image: url('/images/terminal-noise.png');
    background-size: 256px 256px;
    background-repeat: repeat;
    will-change: transform;
    z-index: 100;
    opacity: 0.024;
    transition: opacity 0.3s ease;
  }

  .noise.hidden {
    opacity: 0 !important;
  }

  .overlay {
    pointer-events: none;
    position: absolute;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(180deg, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0.25) 50%, rgba(0, 0, 0, 0) 100%);
    background-size: auto 5px;
    z-index: 101;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .overlay.hidden {
    opacity: 0 !important;
  }

  .scanline {
    content: '';
    pointer-events: none;
    position: absolute;
    display: block;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(
      0deg,
      transparent 0%,
      var(--terminal-200) 2%,
      var(--terminal-500) 3%,
      var(--terminal-200) 3%,
      transparent 100%
    );
    background-repeat: no-repeat;
    will-change: transform;
    opacity: 0.5;
    z-index: 102;
    transition: opacity 0.3s ease;
  }

  .scanline.hidden {
    opacity: 0 !important;
  }

  .overlay .corner {
    font-size: 5vw;
    position: absolute;
    font-weight: 600;
  }
  .overlay .corner.topRight {
    top: 15px;
    right: 50px;
  }
  .overlay .corner.topLeft {
    top: 15px;
    left: 50px;
  }
  .overlay .corner.bottomRight {
    bottom: 15px;
    right: 50px;
  }
  .overlay .corner.bottomLeft {
    bottom: 15px;
    left: 50px;
  }
  .overlay .overlayText {
    position: absolute;
    bottom: 40px;
    left: 120px;
    padding: 5px 15px;
    font-size: 1vw;
    line-height: 1;
    color: var(--terminal-bg-primary);
    background-color: var(--terminal-bg-secondary);
    color: var(--terminal-500);
  }

  .terminal {
    display: block;
    box-sizing: inherit;
    height: 100vh;

    margin: 0 auto;
    padding: 35px 35px 65px;
    text-transform: uppercase;
    overflow-y: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .noise:not([data-effect-enabled='true']) {
      display: none;
    }
    .scanline:not([data-effect-enabled='true']) {
      display: none;
    }
  }
</style>
