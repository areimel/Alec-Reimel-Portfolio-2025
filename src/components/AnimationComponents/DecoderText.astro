---
// Markup only: `src/animation/decode.ts` finds `.decoder-text` elements and drives their scramble.
interface Props {
  text: string;
  as?: string;
  className?: string;
  delay?: number;
  duration?: number;
  charDelay?: number;
  trigger?: 'in-view' | 'loadingScreenEnd' | 'hover' | 'click';
  mobileDisable?: boolean;
}

const {
  text,
  as: Element = 'span',
  className = '',
  delay = 0,
  duration = 500,
  charDelay = 150,
  trigger = 'in-view',
  mobileDisable = false,
} = Astro.props;
---

<Element
  class:list={['decoder-text', className]}
  data-delay={delay}
  data-duration={duration}
  data-char-delay={charDelay}
  data-trigger={trigger}
  data-mobile-disable={mobileDisable}>{text}</Element
>
