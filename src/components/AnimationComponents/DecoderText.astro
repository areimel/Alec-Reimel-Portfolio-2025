---
interface Props {
  text: string;
  as?: string;
  className?: string;
  delay?: number;
  duration?: number;
  charDelay?: number;
  trigger?: 'in-view' | 'loadingScreenEnd' | 'hover' | 'click';
  mobileDisable?: boolean;
}

const {
  text,
  as: Element = 'span',
  className = '',
  delay = 0,
  duration = 500,
  charDelay = 150,
  trigger = 'in-view',
  mobileDisable = false,
} = Astro.props;
let characterOffset = 0;
const words = text.split(' ').map((word) => {
  const characters = Array.from(word).map((char) => ({ char, index: characterOffset++ }));
  characterOffset++;
  return characters;
});
---

<Element
  class:list={['decoder-text', className]}
  data-text={text}
  data-delay={delay}
  data-duration={duration}
  data-char-delay={charDelay}
  data-trigger={trigger}
  data-mobile-disable={mobileDisable}
>
  {
    words.map((characters, wordIndex) => (
      <>
        <span class="decoder-word">
          {characters.map(({ char, index }) => (
            <span class="decoder-char" data-char={char} data-index={index} set:text={char} />
          ))}
        </span>
        {wordIndex < words.length - 1 && <span class="decoder-space"> </span>}
      </>
    ))
  }
</Element>

<script>
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
  let cleanup: (() => void) | undefined;

  function initializeDecoders() {
    cleanup?.();
    const controller = new AbortController();
    const observers: IntersectionObserver[] = [];
    const timers = new Set<ReturnType<typeof setTimeout>>();
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 767px)');
    const restores: (() => void)[] = [];
    const later = (callback: () => void, delay: number) => {
      const timer = setTimeout(() => {
        timers.delete(timer);
        callback();
      }, delay);
      timers.add(timer);
    };
    const number = (value: string | undefined, fallback: number) => {
      const parsed = Number(value);
      return Number.isFinite(parsed) && parsed >= 0 ? parsed : fallback;
    };

    document.querySelectorAll<HTMLElement>('.decoder-text').forEach((element) => {
      const characters = Array.from(element.querySelectorAll<HTMLElement>('.decoder-char'));
      const trigger = element.dataset.trigger;
      const repeatable = trigger === 'hover' || trigger === 'click';
      let running = false;
      let completed = false;
      let generation = 0;
      const disabled = () => motion.matches || (mobile.matches && element.dataset.mobileDisable === 'true');
      const restore = () => {
        generation++;
        characters.forEach((character) => (character.textContent = character.dataset.char || ''));
        element.style.opacity = '1';
        running = false;
      };
      restores.push(restore);
      const start = () => {
        if (disabled()) {
          restore();
          return;
        }
        if (running || (completed && !repeatable)) return;
        running = true;
        const currentGeneration = ++generation;
        later(
          () => {
            if (generation !== currentGeneration) return;
            element.style.opacity = '1';
            if (!characters.length) {
              running = false;
              completed = true;
              return;
            }
            let remaining = characters.length;
            characters.forEach((character) => {
              const end =
                performance.now() +
                number(element.dataset.duration, 500) +
                number(character.dataset.index, 0) * number(element.dataset.charDelay, 150);
              const tick = () => {
                if (generation !== currentGeneration) return;
                if (performance.now() >= end) {
                  character.textContent = character.dataset.char || '';
                  if (--remaining === 0) {
                    running = false;
                    completed = true;
                  }
                  return;
                }
                character.textContent = CHARS[Math.floor(Math.random() * CHARS.length)];
                later(tick, 50);
              };
              tick();
            });
          },
          number(element.dataset.delay, 0)
        );
      };
      const skip = () => {
        if (disabled()) restore();
      };
      motion.addEventListener('change', skip, { signal: controller.signal });
      mobile.addEventListener('change', skip, { signal: controller.signal });
      if (disabled()) return;
      // Interactive text stays readable while waiting for a user action.
      if (!repeatable) element.style.opacity = '0';
      const target = element.closest('.animation-wrapper') || element;
      if (repeatable) {
        target.addEventListener(trigger === 'hover' ? 'mouseenter' : 'click', start, { signal: controller.signal });
      } else if (trigger === 'loadingScreenEnd') {
        const loadingScreen = document.getElementById('loading-screen');
        if (!loadingScreen || getComputedStyle(loadingScreen).display === 'none') start();
        else {
          document.addEventListener('loading-screen-end', start, { signal: controller.signal });
        }
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              start();
              observer.disconnect();
            }
          },
          { rootMargin: '0px 0px -5% 0px' }
        );
        observer.observe(element);
        observers.push(observer);
      }
    });

    cleanup = () => {
      controller.abort();
      observers.forEach((observer) => observer.disconnect());
      timers.forEach(clearTimeout);
      restores.forEach((restore) => restore());
      cleanup = undefined;
    };
  }

  document.addEventListener('astro:page-load', initializeDecoders);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>

<style>
  .decoder-text {
    display: inline-flex;
    flex-wrap: wrap;
  }

  .decoder-word {
    display: inline-block;
    white-space: nowrap;
  }

  .decoder-char {
    display: inline-block;
  }

  .decoder-space {
    display: inline-block;
    width: 1ch;
  }
</style>
