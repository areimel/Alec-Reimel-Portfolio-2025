---
import DecoderText from './DecoderText.astro';

interface Props {
  animation: 'DecoderText';
  trigger?: 'in-view' | 'loadingScreenEnd' | 'hover' | 'click';
  mobileDisable?: boolean;
  delay?: number;
  text?: string;
  className?: string;
  duration?: number;
  charDelay?: number;
  as?: string;
}

const { animation, trigger = 'in-view', mobileDisable = false, text = '', ...restProps } = Astro.props;
if (animation !== 'DecoderText') throw new Error(`Animation component "${animation}" not found`);
---

<div class="animation-wrapper" data-animation={animation} data-trigger={trigger}>
  <DecoderText {text} {trigger} {mobileDisable} {...restProps} />
</div>

<style>
  .animation-wrapper {
    display: inline-block;
  }
</style>
