---
// No props needed for this component
---

<noscript
  ><style>
    #loading-screen {
      display: none !important;
    }
  </style></noscript
>
<div id="loading-screen" class="fixed inset-0 bg-terminal-bg-primary z-[100] flex flex-col items-center justify-center">
  <!-- Terminal-style loading container -->
  <div
    class="loading-container relative bg-terminal-bg-secondary border border-terminal-500 p-8 rounded-lg shadow-lg max-w-md w-full mx-4"
  >
    <!-- Stronger shadow, revealed by fading opacity only (shadows are never animated) -->
    <div class="loading-glow" aria-hidden="true"></div>
    <!-- Terminal header -->
    <div class="terminal-header text-center mb-6">
      <h2 class="text-2xl font-bold text-terminal-bright font-mono text-glow-strong">//LOADING</h2>
      <p class="text-terminal-400 font-mono mt-2">Initializing terminal interface...</p>
    </div>

    <!-- Progress bar container -->
    <div class="progress-container">
      <div class="w-full h-3 bg-terminal-bg-primary border border-terminal-300 rounded-sm overflow-hidden mb-3">
        <div
          id="loading-progress-bar"
          class="h-full bg-terminal-500 w-full origin-left transition-transform duration-300"
          style="transform: scaleX(0)"
        >
        </div>
      </div>

      <!-- Progress text -->
      <div class="flex justify-between items-center text-sm">
        <span id="loading-status" class="text-terminal-400 font-mono">Starting up...</span>
        <span id="loading-percentage" class="text-terminal-500 font-mono font-bold">0%</span>
      </div>
    </div>
  </div>
</div>

<style>
  /* Terminal-style loading container styling */
  .loading-container {
    box-shadow:
      0 0 20px var(--terminal-300),
      0 0 40px var(--terminal-200),
      inset 0 0 20px var(--terminal-bg-accent);
  }

  /* Progress bar glow effect */
  #loading-progress-bar {
    background: linear-gradient(90deg, var(--terminal-500), var(--terminal-bright));
  }

  /* Terminal header glow */
  .terminal-header h2 {
    text-shadow: var(--theme-glow-strong);
  }

  .loading-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    box-shadow:
      0 0 25px var(--terminal-400),
      0 0 50px var(--terminal-300),
      inset 0 0 25px var(--terminal-bg-accent);
    animation: loadingGlow 2000ms ease-in-out infinite alternate;
  }

  @keyframes loadingGlow {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-glow {
      animation: none;
    }
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .loading-container {
      margin: 1rem;
      padding: 1.5rem;
    }

    .terminal-header h2 {
      font-size: 1.5rem;
    }
  }
</style>
